# FinAlly environment. Copy to `.env` (gitignored) and fill in.

# Required for AI chat: OpenRouter API key (LiteLLM -> OpenRouter -> Cerebras)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: set to "true" for deterministic mock LLM responses (E2E tests, no key needed)
LLM_MOCK=false

# --- Market data -------------------------------------------------------------

# Real market data from Polygon.io (now branded Massive). Put your Polygon key here;
# a key from polygon.io or massive.com works the same. POLYGON_API_KEY is accepted
# as an alias; if both are set, MASSIVE_API_KEY wins.
# Empty or unset -> the built-in GBM simulator is used.
# A free key works too: snapshots return 403 on the free plan, so the backend
# falls back automatically to end-of-day prices (refreshed every 30 min).
MASSIVE_API_KEY=
# POLYGON_API_KEY=

# Optional: live-mode Massive poll interval in seconds (default 15, minimum 1).
# Use 15 on Starter; 2-5 on plans without a per-minute cap.
MASSIVE_POLL_INTERVAL=15

# Optional: simulator per-ticker, per-tick (500 ms) chance of a 2-5% jump (default 0.001).
# 0.001 with 10 tickers is about one jump every 50 s; use 0.0002 for calmer prices.
SIM_EVENT_PROBABILITY=0.001

# Optional: integer seed for a reproducible simulator price path (E2E tests, demos).
# Leave empty for a different path on every start.
SIM_SEED=

# --- App / testing -----------------------------------------------------------

# Optional: "true" exposes POST /api/reset (wipes data, re-seeds $10k + default
# watchlist). Intended for E2E tests only; leave false otherwise.
ENABLE_RESET=false

# Optional: SQLite file location. Defaults to <repo>/db/finally.db for local dev;
# the Docker image sets /app/db/finally.db (the finally-data volume). Leave unset.
# DB_PATH=

# Optional: directory holding the Next.js static export served at /.
# Defaults to backend/static locally; the Docker image sets /app/static. Leave unset.
# STATIC_DIR=
